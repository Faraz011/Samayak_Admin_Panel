{
  "name": "samayak-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Samayak Admin Panel — Academic Operations Platform for BIT Mesra",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "pnpm --filter @samayak/web dev",
    "dev:worker": "pnpm --filter @samayak/worker dev",
    "build:web": "pnpm --filter @samayak/web build",
    "build:worker": "pnpm --filter @samayak/worker build",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "db:types": "supabase gen types typescript --project-id urgtpxnrutgeiyuxkawx > packages/db/src/database.types.ts",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
